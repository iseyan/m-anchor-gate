{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m-anchor:demo1:decision:v0.1",
  "title": "Demo 1 decision record v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "case_id",
    "reader_process",
    "read_at_utc",
    "state_version_read",
    "K_read",
    "evidence_basis",
    "rule_version",
    "state_sha256",
    "state_writer_process",
    "transition_audit_id",
    "action_record_id",
    "selected_action",
    "action_sha256",
    "summary_read",
    "decision_rule",
    "decision_inputs",
    "summary_used_for_decision",
    "status",
    "decision_ja",
    "decision_en"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "demo1-decision/v0.1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "reader_process": {
      "type": "object",
      "required": [
        "pid",
        "instance_id",
        "started_at_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "read_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "state_version_read": {
      "type": "integer",
      "minimum": 0
    },
    "K_read": {
      "type": "array",
      "items": {
        "enum": [
          "h_A",
          "h_B"
        ]
      },
      "uniqueItems": true,
      "maxItems": 2
    },
    "evidence_basis": {
      "type": "array",
      "items": {
        "const": "e_B"
      },
      "uniqueItems": true,
      "maxItems": 1
    },
    "rule_version": {
      "enum": [
        "empty-basis-identity/v1",
        "demo1-evidence-map/v0.1"
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_writer_process": {
      "type": "object",
      "required": [
        "pid",
        "instance_id",
        "started_at_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "transition_audit_id": {
      "type": "string",
      "minLength": 1
    },
    "action_record_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_action": {
      "enum": [
        "a_A",
        "a_B"
      ]
    },
    "action_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "summary_read": {
      "type": "object",
      "required": [
        "summary_id",
        "case_id",
        "state_version_at_save",
        "text_ja",
        "text_en",
        "admitted_as_evidence",
        "writer_process",
        "saved_at_utc"
      ],
      "additionalProperties": false,
      "properties": {
        "summary_id": {
          "const": "summary-001"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "state_version_at_save": {
          "type": "integer",
          "minimum": 0
        },
        "text_ja": {
          "type": "string",
          "minLength": 1
        },
        "text_en": {
          "type": "string",
          "minLength": 1
        },
        "admitted_as_evidence": {
          "const": false
        },
        "writer_process": {
          "type": "object",
          "required": [
            "pid",
            "instance_id",
            "started_at_utc"
          ],
          "additionalProperties": false,
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "instance_id": {
              "type": "string",
              "minLength": 1
            },
            "started_at_utc": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "saved_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "decision_rule": {
      "const": "candidate-cardinality-and-action/v0.1"
    },
    "decision_inputs": {
      "type": "object",
      "required": [
        "K",
        "selected_action"
      ],
      "additionalProperties": false,
      "properties": {
        "K": {
          "type": "array",
          "items": {
            "enum": [
              "h_A",
              "h_B"
            ]
          },
          "uniqueItems": true,
          "maxItems": 2
        },
        "selected_action": {
          "enum": [
            "a_A",
            "a_B"
          ]
        }
      }
    },
    "summary_used_for_decision": {
      "const": false
    },
    "status": {
      "enum": [
        "unresolved",
        "single_candidate_under_interpretation",
        "candidate_exhaustion"
      ]
    },
    "decision_ja": {
      "type": "string",
      "minLength": 1
    },
    "decision_en": {
      "type": "string",
      "minLength": 1
    }
  }
}
