{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 3 development proposal",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "stage3-proposal/v0.1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "expected_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposed_K": {
      "type": "array",
      "items": {
        "enum": [
          "h_A",
          "h_B"
        ]
      },
      "uniqueItems": true,
      "maxItems": 2
    },
    "selected_action": {
      "enum": [
        "a_A",
        "a_B"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "case_id",
    "expected_version",
    "expected_state_sha256",
    "proposed_K",
    "selected_action",
    "evidence_ids",
    "reason"
  ],
  "additionalProperties": false
}
